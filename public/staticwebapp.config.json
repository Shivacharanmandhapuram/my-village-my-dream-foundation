{
  "routes": [
    {
      "route": "/api/cms/*",
      "allowedRoles": [
        "admin"
      ]
    },
    {
      "route": "/.auth/login/twitter",
      "statusCode": 404
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*",
      "/assets/*",
      "/api/*"
    ]
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
